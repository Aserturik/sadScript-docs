---
interface Props {
  code: string;
}

const { code } = Astro.props;

function escapeHtml(input: string): string {
  return input.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function highlight(raw: string): string {
  const keywords = [
    'si_duele', 'si_no_duele', 'si_no_duele_pero', 'mientras_duela',
    'para_que_duela', 'aunque_no_quiera', 'cortarme', 'seguir_fingiendo',
    'ritual', 'regresar_a_llorar', 'confesar', 'intentar_sentir',
    'romperse', 'colapsar', 'afirmar', 'segun_mi_animo', 'caso',
    'por_defecto_mio', 'sum', 'prod', 'max', 'min', 'prom',
    'vivo', 'muerto', 'nulo'
  ];
  const types = ['dolor', 'vacio', 'esperanza', 'recuerdo', 'cicatriz', 'trauma'];

  const placeholders: string[] = [];
  const stash = (html: string) => {
    const token = `__SAD_TOKEN_${placeholders.length}__`;
    placeholders.push(html);
    return token;
  };

  let result = escapeHtml(raw)
    .replace(/("([^"\\]|\\.)*")/g, (match) => stash(`<span class="string">${match}</span>`))
    .replace(/(\/\/.*)/g, (match) => stash(`<span class="comment">${match}</span>`));

  result = result.replace(/\b(\d+\.?\d*(?:e\d+)?)\b/g, '<span class="number">$1</span>');

  for (const kw of keywords) {
    result = result.replace(new RegExp(`\\b(${kw})\\b`, 'g'), '<span class="keyword">$1</span>');
  }

  for (const t of types) {
    result = result.replace(new RegExp(`\\b(${t})\\b`, 'g'), '<span class="type">$1</span>');
  }

  placeholders.forEach((html, index) => {
    result = result.replace(`__SAD_TOKEN_${index}__`, html);
  });

  return result;
}
---

<div class="sadcode-block">
  <div class="sadcode-frame">
    <div class="sadcode-toolbar">
      <span class="sadcode-dot red"></span>
      <span class="sadcode-dot yellow"></span>
      <span class="sadcode-dot green"></span>
      <span class="sadcode-title">oscura_mente.sad</span>
    </div>
    <pre class="sadcode-body"><code set:html={highlight(code)} /></pre>
  </div>
</div>

<style>
  .sadcode-block {
    border: 2px solid rgba(255, 102, 204, 0.45);
    box-shadow: 0 0 18px rgba(138, 43, 226, 0.18);
    border-radius: 8px;
    overflow: hidden;
    margin: 1rem 0;
  }

  .sadcode-frame {
    background: linear-gradient(180deg, #1a1021 0%, #0b0810 100%);
  }

  .sadcode-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: linear-gradient(180deg, #2a1f35 0%, #1a1021 100%);
    border-bottom: 1px solid rgba(255, 102, 204, 0.2);
  }

  .sadcode-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .sadcode-dot.red { background: #ff5f57; }
  .sadcode-dot.yellow { background: #febc2e; }
  .sadcode-dot.green { background: #28c840; }

  .sadcode-title {
    color: #8f6fa7;
    font-size: 0.8rem;
    font-family: "Courier New", monospace;
    margin-left: 8px;
  }

  .sadcode-body {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: "Courier New", monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    background: transparent;
  }

  .sadcode-body code {
    color: #c8c8c8;
    font-family: "Courier New", monospace;
  }

  /* Syntax highlighting spans are injected via set:html, so they have no Astro hash */
  .sadcode-body :global(.keyword) {
    color: #ff69b4;
    font-weight: 700;
  }

  .sadcode-body :global(.type) {
    color: #8a2be2;
  }

  .sadcode-body :global(.string) {
    color: #00ff7f;
  }

  .sadcode-body :global(.comment) {
    color: #666;
    font-style: italic;
  }

  .sadcode-body :global(.number) {
    color: #ff6347;
  }
</style>
