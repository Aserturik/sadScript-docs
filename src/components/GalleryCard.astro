---
interface Props {
  image: string;
  alt: string;
  code: string;
  label: string;
  quote: string;
  title: string;
  subtitle: string;
  status: string;
  chips: string[];
}

const { image, alt, code, label, quote, title, subtitle, status, chips } = Astro.props;

// Simple syntax highlighter for SadScript
function highlight(raw: string): string {
  const keywords = [
    'si_duele', 'si_no_duele', 'si_no_duele_pero', 'mientras_duela',
    'para_que_duela', 'aunque_no_quiera', 'cortarme', 'seguir_fingiendo',
    'ritual', 'regresar_a_llorar', 'confesar', 'intentar_sentir',
    'romperse', 'colapsar', 'afirmar', 'segun_mi_animo', 'caso',
    'por_defecto_mio', 'vivo', 'muerto', 'nulo',
    'sum', 'prod', 'max', 'min', 'prom',
  ];
  const types = ['dolor', 'vacio', 'esperanza', 'recuerdo', 'cicatriz', 'trauma'];

  let result = raw;

  // Escape HTML first
  result = result.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // Comments (// ...)
  result = result.replace(/(\/\/.*)/g, '<span class="comment">$1</span>');

  // Strings ("...")
  result = result.replace(/("([^"]*)")/g, '<span class="string">$1</span>');

  // Numbers
  result = result.replace(/\b(\d+\.?\d*(?:e\d+)?)\b/g, '<span class="number">$1</span>');

  // Keywords
  for (const kw of keywords) {
    const re = new RegExp(`\\b(${kw})\\b`, 'g');
    result = result.replace(re, '<span class="keyword">$1</span>');
  }

  // Types
  for (const t of types) {
    const re = new RegExp(`\\b(${t})\\b`, 'g');
    result = result.replace(re, '<span class="type">$1</span>');
  }

  return `<pre><code>${result}</code></pre>`;
}
---

<article class="carousel-card">
  <div class="component-window">
    <div class="component-media">
      <img src={image} alt={alt} />
    </div>
    <div class="window-chrome">
      <span class="window-light red"></span>
      <span class="window-light yellow"></span>
      <span class="window-light green"></span>
      <span class="window-title">{status}</span>
    </div>
    <div class="card-overlay">
      <div class="card-label">{label}</div>
      <h3 class="card-title">{title}</h3>
      <p class="card-subtitle">{subtitle}</p>
      <div class="chip-row" aria-label="component tags">
        {chips.map((chip) => <span class="chip">{chip}</span>)}
      </div>
      <div class="card-code" set:html={highlight(code)}></div>
      <div class="card-quote">{quote}</div>
    </div>
  </div>
</article>
