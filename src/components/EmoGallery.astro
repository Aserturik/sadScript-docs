<style>
  .gallery-wrapper {
    margin-top: 2rem;
  }
  .gallery-title {
    text-align: center;
    font-size: 1.5rem;
    color: #8a2be2;
    margin-top: 2rem;
    text-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
  }
  .gallery-subtitle {
    text-align: center;
    color: #666;
    font-size: 0.9rem;
    margin-top: -1rem;
  }
  .carousel {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2rem 1rem;
    scrollbar-width: thin;
    scrollbar-color: #8a2be2 #1a1a2e;
  }
  .carousel::-webkit-scrollbar {
    height: 6px;
  }
  .carousel::-webkit-scrollbar-track {
    background: #1a1a2e;
    border-radius: 3px;
  }
  .carousel::-webkit-scrollbar-thumb {
    background: #8a2be2;
    border-radius: 3px;
  }
  .carousel-card {
    flex: 0 0 320px;
    height: 420px;
    scroll-snap-align: center;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 15px rgba(138, 43, 226, 0.2);
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .carousel-card:hover {
    transform: scale(1.03);
    box-shadow: 0 0 30px rgba(138, 43, 226, 0.6);
  }
  .carousel-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(40%) contrast(1.1) brightness(0.8);
    transition: filter 0.4s ease, transform 0.4s ease;
  }
  .carousel-card:hover img {
    filter: grayscale(60%) contrast(1.2) brightness(0.3);
    transform: scale(1.1);
  }
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.2rem;
    background: linear-gradient(
      0deg,
      rgba(10, 10, 25, 0.95) 0%,
      rgba(10, 10, 25, 0.7) 50%,
      transparent 100%
    );
    transition: background 0.4s ease;
  }
  .carousel-card:hover .card-overlay {
    background: linear-gradient(
      0deg,
      rgba(10, 10, 25, 0.98) 0%,
      rgba(10, 10, 25, 0.9) 60%,
      rgba(10, 10, 25, 0.6) 100%
    );
  }
  .card-quote {
    color: #aaa;
    font-style: italic;
    font-size: 0.8rem;
    text-align: center;
    padding: 0.4rem 0;
    border-top: 1px dashed #444;
    margin-top: 0.8rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }
  .carousel-card:hover .card-quote {
    opacity: 1;
  }
  .card-code {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.5s ease, opacity 0.3s ease 0.1s;
  }
  .carousel-card:hover .card-code {
    max-height: 300px;
    opacity: 1;
  }
  .card-code pre {
    font-family: "Courier New", monospace;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #c8c8c8;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .card-code .keyword {
    color: #ff69b4;
    font-weight: bold;
  }
  .card-code .type {
    color: #8a2be2;
  }
  .card-code .string {
    color: #00ff7f;
  }
  .card-code .comment {
    color: #666;
    font-style: italic;
  }
  .card-code .number {
    color: #ff6347;
  }
  .card-label {
    color: #8a2be2;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease 0.2s, transform 0.3s ease 0.2s;
  }
  .carousel-card:hover .card-label {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<slot />
