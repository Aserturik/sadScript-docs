<style>
  .gallery-wrapper {
    margin-top: 2rem;
    padding: 1.25rem;
    border: 4px ridge #8a2be2;
    background:
      radial-gradient(circle at top, rgba(138, 43, 226, 0.22), transparent 45%),
      linear-gradient(180deg, #100816 0%, #07050b 100%);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06), 0 0 30px rgba(138, 43, 226, 0.2);
  }
  .gallery-title {
    text-align: center;
    font-size: 1.5rem;
    color: #ff66cc;
    margin-top: 0.75rem;
    text-shadow: 0 0 8px rgba(255, 102, 204, 0.6), 0 0 16px rgba(138, 43, 226, 0.35);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .gallery-subtitle {
    text-align: center;
    color: #b6a7c8;
    font-size: 0.9rem;
    margin-top: -0.75rem;
    font-family: "Courier New", monospace;
  }
  :global(.grid) {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  :global(.grid.top) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  :global(.grid.bottom) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  :global(.grid) :global(.carousel-card) {
    display: flex;
    min-width: 0;
    height: auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 15px rgba(138, 43, 226, 0.2);
    border: 2px solid rgba(255, 102, 204, 0.45);
    background: #0c0810;
  }
  :global(.grid) :global(.component-window),
  :global(.grid) :global(.card-overlay) {
    height: auto;
  }
  :global(.grid) :global(.component-window) {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    background: linear-gradient(180deg, #1a1021 0%, #0b0810 100%);
  }
  :global(.grid) :global(.component-media) {
    position: relative;
    height: 260px;
    overflow: hidden;
    border-bottom: 2px solid rgba(255, 102, 204, 0.35);
    flex: 0 0 auto;
  }
  :global(.grid) :global(.component-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(35%) contrast(1.08) brightness(0.82) sepia(0.1);
    transform: scale(1.02);
    display: block;
  }
  :global(.grid) :global(.component-media)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(7, 5, 11, 0.2) 50%, rgba(7, 5, 11, 0.72) 100%);
  }
  :global(.grid) :global(.card-overlay) {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1rem 1.15rem 1.15rem;
    background: linear-gradient(0deg, rgba(10, 10, 25, 0.98) 0%, rgba(10, 10, 25, 0.8) 60%, transparent 100%);
    overflow: visible;
  }
  :global(.grid) :global(.card-label) {
    color: #ff66cc;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.4rem;
    opacity: 0.9;
  }
  :global(.grid) :global(.card-title) {
    margin: 0;
    color: #fff;
    font-size: 1.35rem;
    text-shadow: 0 0 10px rgba(255, 102, 204, 0.35);
  }
  :global(.grid) :global(.card-subtitle) {
    margin: 0.35rem 0 0.75rem;
    color: #d0c3de;
    font-size: 0.9rem;
    font-family: "Courier New", monospace;
  }
  :global(.grid) :global(.chip-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  :global(.grid) :global(.chip) {
    padding: 0.2rem 0.45rem;
    border: 1px solid rgba(255, 102, 204, 0.6);
    background: rgba(18, 8, 24, 0.8);
    color: #ffb3e6;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  :global(.grid) :global(.card-code) {
    max-height: none;
  }
  :global(.grid) :global(.card-code pre) {
    font-family: "Courier New", monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    color: #c8c8c8;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  :global(.grid) :global(.card-code .keyword) { color: #ff69b4; font-weight: bold; }
  :global(.grid) :global(.card-code .type) { color: #8a2be2; }
  :global(.grid) :global(.card-code .string) { color: #00ff7f; }
  :global(.grid) :global(.card-code .comment) { color: #666; font-style: italic; }
  :global(.grid) :global(.card-code .number) { color: #ff6347; }
  :global(.grid) :global(.card-quote) {
    color: #aaa;
    font-style: italic;
    font-size: 0.78rem;
    text-align: center;
    padding: 0.4rem 0 0;
    border-top: 1px dashed #444;
    margin-top: 0.6rem;
  }
  @media (max-width: 900px) {
    :global(.grid.top),
    :global(.grid.bottom) {
      grid-template-columns: 1fr;
    }
    :global(.grid) :global(.carousel-card) {
      height: auto;
    }
    :global(.grid) :global(.component-media) {
      height: 220px;
    }
  }
</style>

<div class="gallery-wrapper">
  <slot />
</div>
